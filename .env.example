# 解释层：mock（默认，无需密钥）或 openai 兼容接口（DeepSeek / OpenAI / 自建）
EXPLAIN_PROVIDER=mock
EXPLAIN_BASE_URL=https://api.deepseek.com/v1
EXPLAIN_MODEL=deepseek-chat
EXPLAIN_API_KEY=
EXPLAIN_TIMEOUT=20
EXPLAIN_MAX_TOKENS=700

# 本地账号：用 scripts/create_user.py 创建；密码哈希存库，Cookie 仅放随机会话令牌
NETCFG_SESSION_HOURS=12
NETCFG_COOKIE_SECURE=false
